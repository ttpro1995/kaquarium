{
  "name": "kaquarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run packages/*/tests",
    "test:coverage": "vitest run --coverage packages/*/tests",
    "lint": "eslint packages/*/src packages/*/tests"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
